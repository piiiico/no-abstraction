# isqrt — hand-encoded aarch64 ELF (little-endian bytes). '#' comments are stripped; nothing else is.
# ELF header
7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00
02 00 b7 00 01 00 00 00
78 00 40 00 00 00 00 00
40 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00
40 00 38 00 01 00 40 00 00 00 00 00
# PT_LOAD rwx, vaddr 0x400000, filesz 0x198, memsz 0x20000
01 00 00 00 07 00 00 00
00 00 00 00 00 00 00 00
00 00 40 00 00 00 00 00
00 00 40 00 00 00 00 00
98 01 00 00 00 00 00 00
00 00 02 00 00 00 00 00
00 10 00 00 00 00 00 00
# code @0x400078
13 08 a0 d2  13 00 82 f2  14 00 80 d2          # x19=0x401000 buf, x20=len
00 00 80 d2  61 02 14 8b  e2 1f 80 d2  42 00 14 cb  e2 00 00 b4   # rd: read(0, buf+len, 255-len)
e8 07 80 d2  01 00 00 d4  1f 00 00 f1  6d 00 00 54  94 02 00 8b  f6 ff ff 17
15 00 80 d2  16 00 80 d2  41 01 80 d2          # pos=0 n=0 ten=10
bf 02 14 eb  0a 01 00 54  60 6a 75 38  00 c0 00 51  1f 24 00 71  88 00 00 54   # dig
d6 02 01 9b  b5 06 00 91  f8 ff ff 17
03 00 80 d2  04 00 e8 d2                       # res=0 bit=1<<62
9f 00 16 eb  69 00 00 54  84 fc 42 d3  a4 ff ff b5            # while bit>n: bit>>=2
64 01 00 b4  65 00 04 8b  df 02 05 eb  a3 00 00 54            # L2
d6 02 05 cb  63 fc 41 d3  63 00 04 8b  02 00 00 14
63 fc 41 d3  84 fc 42 d3  f6 ff ff 17
3c 08 a0 d2  1c 00 82 f2  29 08 a0 d2  09 00 84 f2            # x28=out 0x411000, x9=tmp end 0x412000
ea 03 09 aa  eb 03 03 aa  4c 01 80 d2
6d 09 cc 9a  ae ad 0c 9b  ce c1 00 11  4a 05 00 d1  4e 01 00 39  eb 03 0d aa  4b ff ff b5   # digits
4e 15 40 38  8e 17 00 38  5f 01 09 eb  a1 ff ff 54            # copy
4e 01 80 52  8e 17 00 38                       # '\n'
21 08 a0 d2  01 00 82 f2  82 03 01 cb  20 00 80 d2  08 08 80 d2  01 00 00 d4   # write
00 00 80 d2  a8 0b 80 d2  01 00 00 d4          # exit(0)
