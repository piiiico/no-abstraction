(module
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 512)
  (data (i32.const 128) "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
  (global $IN i32 (i32.const 1048576))
  (global $OUT i32 (i32.const 17825792))
  (global $o (mut i32) (i32.const 17825792))

  (func $read_all (result i32) (local $n i32)
    (loop $l
      (i32.store (i32.const 0) (i32.add (global.get $IN) (local.get $n)))
      (i32.store (i32.const 4) (i32.sub (i32.const 16777216) (local.get $n)))
      (i32.store (i32.const 8) (i32.const 0))
      (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))
      (if (i32.gt_s (i32.load (i32.const 8)) (i32.const 0))
        (then (local.set $n (i32.add (local.get $n) (i32.load (i32.const 8)))) (br $l))))
    (local.get $n))
  (func $write_all (param $p i32) (param $len i32)
    (loop $l
      (if (i32.gt_s (local.get $len) (i32.const 0)) (then
        (i32.store (i32.const 16) (local.get $p))
        (i32.store (i32.const 20) (local.get $len))
        (i32.store (i32.const 24) (i32.const 0))
        (drop (call $fd_write (i32.const 1) (i32.const 16) (i32.const 1) (i32.const 24)))
        (if (i32.le_s (i32.load (i32.const 24)) (i32.const 0)) (then (return)))
        (local.set $p (i32.add (local.get $p) (i32.load (i32.const 24))))
        (local.set $len (i32.sub (local.get $len) (i32.load (i32.const 24))))
        (br $l)))))
  (func $put (param $b i32)
    (i32.store8 (global.get $o) (local.get $b))
    (global.set $o (i32.add (global.get $o) (i32.const 1))))
  (func $sym (param $v i32)
    (call $put (i32.load8_u (i32.add (i32.const 128) (i32.and (local.get $v) (i32.const 63))))))
  (func $b (param $i i32) (result i32) (i32.load8_u (i32.add (global.get $IN) (local.get $i))))

  (func (export "_start") (local $n i32) (local $i i32) (local $w i32) (local $r i32)
    (local.set $n (call $read_all))
    (block $e (loop $l
      (br_if $e (i32.gt_u (i32.add (local.get $i) (i32.const 3)) (local.get $n)))
      (local.set $w (i32.or (i32.or
        (i32.shl (call $b (local.get $i)) (i32.const 16))
        (i32.shl (call $b (i32.add (local.get $i) (i32.const 1))) (i32.const 8)))
        (call $b (i32.add (local.get $i) (i32.const 2)))))
      (call $sym (i32.shr_u (local.get $w) (i32.const 18)))
      (call $sym (i32.shr_u (local.get $w) (i32.const 12)))
      (call $sym (i32.shr_u (local.get $w) (i32.const 6)))
      (call $sym (local.get $w))
      (local.set $i (i32.add (local.get $i) (i32.const 3)))
      (br $l)))
    (local.set $r (i32.sub (local.get $n) (local.get $i)))
    (if (i32.eq (local.get $r) (i32.const 1)) (then
      (local.set $w (i32.shl (call $b (local.get $i)) (i32.const 16)))
      (call $sym (i32.shr_u (local.get $w) (i32.const 18)))
      (call $sym (i32.shr_u (local.get $w) (i32.const 12)))
      (call $put (i32.const 61)) (call $put (i32.const 61))))
    (if (i32.eq (local.get $r) (i32.const 2)) (then
      (local.set $w (i32.or (i32.shl (call $b (local.get $i)) (i32.const 16))
                            (i32.shl (call $b (i32.add (local.get $i) (i32.const 1))) (i32.const 8))))
      (call $sym (i32.shr_u (local.get $w) (i32.const 18)))
      (call $sym (i32.shr_u (local.get $w) (i32.const 12)))
      (call $sym (i32.shr_u (local.get $w) (i32.const 6)))
      (call $put (i32.const 61))))
    (call $put (i32.const 10))
    (call $write_all (global.get $OUT) (i32.sub (global.get $o) (global.get $OUT))))
)
