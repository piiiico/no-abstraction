(module
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 4)
  (data (i32.const 256) "0123456789abcdef")
  (global $T i32 (i32.const 4096))
  (global $BUF i32 (i32.const 65536))

  (func (export "_start")
    (local $n i32) (local $c i32) (local $k i32) (local $crc i32) (local $got i32) (local $j i32)
    (loop $t
      (local.set $c (local.get $n))
      (local.set $k (i32.const 8))
      (loop $b
        (local.set $c (if (result i32) (i32.and (local.get $c) (i32.const 1))
          (then (i32.xor (i32.shr_u (local.get $c) (i32.const 1)) (i32.const 0xEDB88320)))
          (else (i32.shr_u (local.get $c) (i32.const 1)))))
        (local.set $k (i32.sub (local.get $k) (i32.const 1)))
        (br_if $b (local.get $k)))
      (i32.store (i32.add (global.get $T) (i32.shl (local.get $n) (i32.const 2))) (local.get $c))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br_if $t (i32.lt_u (local.get $n) (i32.const 256))))
    (local.set $crc (i32.const -1))
    (block $eof (loop $chunk
      (i32.store (i32.const 0) (global.get $BUF))
      (i32.store (i32.const 4) (i32.const 65536))
      (i32.store (i32.const 8) (i32.const 0))
      (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))
      (local.set $got (i32.load (i32.const 8)))
      (br_if $eof (i32.le_s (local.get $got) (i32.const 0)))
      (local.set $j (i32.const 0))
      (block $e (loop $l
        (br_if $e (i32.ge_u (local.get $j) (local.get $got)))
        (local.set $crc (i32.xor
          (i32.load (i32.add (global.get $T) (i32.shl (i32.and
            (i32.xor (local.get $crc) (i32.load8_u (i32.add (global.get $BUF) (local.get $j))))
            (i32.const 255)) (i32.const 2))))
          (i32.shr_u (local.get $crc) (i32.const 8))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $l)))
      (br $chunk)))
    (local.set $crc (i32.xor (local.get $crc) (i32.const -1)))
    (local.set $k (i32.const 0))
    (loop $h
      (i32.store8 (i32.add (i32.const 512) (local.get $k))
        (i32.load8_u (i32.add (i32.const 256)
          (i32.and (i32.shr_u (local.get $crc) (i32.sub (i32.const 28) (i32.shl (local.get $k) (i32.const 2)))) (i32.const 15)))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $h (i32.lt_u (local.get $k) (i32.const 8))))
    (i32.store8 (i32.const 520) (i32.const 10))
    (i32.store (i32.const 16) (i32.const 512))
    (i32.store (i32.const 20) (i32.const 9))
    (drop (call $fd_write (i32.const 1) (i32.const 16) (i32.const 1) (i32.const 24))))
)
