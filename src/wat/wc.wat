(module
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 4)
  (global $BUF i32 (i32.const 65536))
  (global $o (mut i32) (i32.const 1024))

  (func $put (param $b i32)
    (i32.store8 (global.get $o) (local.get $b))
    (global.set $o (i32.add (global.get $o) (i32.const 1))))
  (func $put_u64 (param $u i64) (local $p i32)
    (local.set $p (i32.const 96))
    (loop $d
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.wrap_i64 (i64.add (i64.rem_u (local.get $u) (i64.const 10)) (i64.const 48))))
      (local.set $u (i64.div_u (local.get $u) (i64.const 10)))
      (br_if $d (i64.ne (local.get $u) (i64.const 0))))
    (loop $c
      (call $put (i32.load8_u (local.get $p)))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br_if $c (i32.lt_u (local.get $p) (i32.const 96)))))

  (func (export "_start")
    (local $got i32) (local $j i32) (local $c i32) (local $lines i64) (local $words i64) (local $bytes i64) (local $inw i32)
    (block $eof (loop $chunk
      (i32.store (i32.const 0) (global.get $BUF))
      (i32.store (i32.const 4) (i32.const 65536))
      (i32.store (i32.const 8) (i32.const 0))
      (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))
      (local.set $got (i32.load (i32.const 8)))
      (br_if $eof (i32.le_s (local.get $got) (i32.const 0)))
      (local.set $bytes (i64.add (local.get $bytes) (i64.extend_i32_u (local.get $got))))
      (local.set $j (i32.const 0))
      (block $e (loop $l
        (br_if $e (i32.ge_u (local.get $j) (local.get $got)))
        (local.set $c (i32.load8_u (i32.add (global.get $BUF) (local.get $j))))
        (if (i32.eq (local.get $c) (i32.const 10))
          (then (local.set $lines (i64.add (local.get $lines) (i64.const 1)))))
        (if (i32.or (i32.eq (local.get $c) (i32.const 32)) (i32.le_u (i32.sub (local.get $c) (i32.const 9)) (i32.const 4)))
          (then (local.set $inw (i32.const 0)))
          (else (if (i32.eqz (local.get $inw)) (then
            (local.set $inw (i32.const 1))
            (local.set $words (i64.add (local.get $words) (i64.const 1)))))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $l)))
      (br $chunk)))
    (call $put_u64 (local.get $lines)) (call $put (i32.const 32))
    (call $put_u64 (local.get $words)) (call $put (i32.const 32))
    (call $put_u64 (local.get $bytes)) (call $put (i32.const 10))
    (i32.store (i32.const 16) (i32.const 1024))
    (i32.store (i32.const 20) (i32.sub (global.get $o) (i32.const 1024)))
    (drop (call $fd_write (i32.const 1) (i32.const 16) (i32.const 1) (i32.const 24))))
)
